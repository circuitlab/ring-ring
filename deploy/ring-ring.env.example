# Discord bot token (Developer Portal > your application > Bot > Reset Token)
DISCORD_TOKEN=

# Channel that received SMS are posted to
# (Discord: enable Developer Mode, right-click the channel > Copy Channel ID)
DISCORD_CHANNEL_ID=

# Delete SMS from the SIM after forwarding. The SIM storage is small and
# new SMS cannot be received once it is full. Requires the polkit rule
# installed by install.sh.
DELETE_AFTER_FORWARD=1

# Forward SMS already on the modem at the very first start (default: skip them)
#FORWARD_EXISTING=0

#SCAN_INTERVAL=60
